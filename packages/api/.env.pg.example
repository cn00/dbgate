# PostgreSQL RBAC storage. Copy to packages/api/.env and replace all placeholders.
# Create the database first; the application creates the rbac_ tables.
# Connection/migration failures stop startup; there is no SQLite fallback.
PORT=3000

# Authentication remains separate from RBAC storage.
AUTH_PROVIDER=logins
LOGIN=admin
PASSWORD=replace-with-a-unique-login-password

RBAC_STORAGE_ENGINE=postgres
RBAC_STORAGE_SERVER=127.0.0.1
RBAC_STORAGE_PORT=5432
RBAC_STORAGE_DATABASE=dbgate_rbac
RBAC_STORAGE_USER=dbgate_rbac
RBAC_STORAGE_PASSWORD=replace-with-the-database-password
# Local development only. Set true for TLS with certificate verification.
RBAC_STORAGE_SSL=false

# Generate a random secret with at least 32 characters; share it across replicas.
RBAC_TOKEN_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Used only for an empty store; remove after initialization.
# This identity must be able to sign in through AUTH_PROVIDER.
RBAC_BOOTSTRAP_PROVIDER=logins
RBAC_BOOTSTRAP_LOGIN=admin

# OAuth alternative: replace AUTH_PROVIDER and the bootstrap identity above,
# remove LOGIN/PASSWORD, and configure the existing identity provider:
# AUTH_PROVIDER=oauth
# OAUTH_AUTH=https://idp.example.com/authorize
# OAUTH_TOKEN=https://idp.example.com/token
# OAUTH_CLIENT_ID=replace-with-client-id
# OAUTH_CLIENT_SECRET=replace-with-client-secret
# OAUTH_SCOPE=openid profile email
# OAUTH_LOGIN_FIELD=email
# RBAC_BOOTSTRAP_PROVIDER=oauth
# RBAC_BOOTSTRAP_LOGIN=admin@example.com

# Do not combine dynamic RBAC with STORAGE_DATABASE or SKIP_ALL_AUTH.
# LOGIN_PERMISSIONS_* / PERMISSIONS are replaced by stored rules in this mode.
# Storage-layer delivery: management UI and full endpoint enforcement are pending.
